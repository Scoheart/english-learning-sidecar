# Copy to .env. Use a separate, optional Model API; never commit API keys.
SIDECAR_HOST=127.0.0.1
SIDECAR_PORT=4317
# Default storage: ~/.english-sidecar (local SQLite + hook token)
# SIDECAR_DATA_DIR=/path/to/private/folder

# Default is demo when no API key is available. Set to live when configured.
# LEARNING_MODE=live
LEARNING_BASE_URL=https://api.openai.com/v1
LEARNING_MODEL=gpt-4o-mini
LEARNING_API_KEY=

# Explicitly enable the "Try a prompt" UI fixture button (off by default)
SIDECAR_DEMO=0
